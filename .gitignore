@"
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environments
.venv/
venv/
ENV/
env/

# Local configuration and credentials
.env
*.local.env

# Data files & local artifacts (Bronze/Silver/Gold local landings)
data/
*.csv
*.parquet
*.json
!configs/**/*.json

# Databricks / IDE configs
.databricks/
.idea/
.vscode/
*.swp

# MLflow local tracking
mlruns/
outputs/

# OS files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
"@ | Out-File -FilePath .gitignore -Encoding utf8

# .md files
PROJECT_PLAN.md
