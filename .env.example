# Copy to .env and fill in. Never commit .env.

# Required for EIA ingest. Register at:
# https://www.eia.gov/opendata/register.php
EIA_API_KEY=your_eia_api_key_here

# Optional overrides (defaults live in configs/region_ercot.json)
# PRIMARY_REGION=ERCO
# BACKFILL_START=2022-01-01

# Databricks (used later to upload Volumes / run jobs)
# DATABRICKS_HOST=https://xxxx.cloud.databricks.com
# DATABRICKS_TOKEN=
