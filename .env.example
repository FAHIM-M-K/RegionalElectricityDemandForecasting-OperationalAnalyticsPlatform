@"
# EIA Open Data API v2 (Register at: https://www.eia.gov/opendata/register.php)
EIA_API_KEY=your_eia_api_key_here

# Region configuration
PRIMARY_REGION=ERCO

# Databricks connection (optional for local sync scripts)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
"@ | Out-File -FilePath .env.example -Encoding utf8
