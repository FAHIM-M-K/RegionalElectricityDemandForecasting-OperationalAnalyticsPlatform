{
  "name": "ERCOT_Daily_Forecast_and_Monitoring",
  "schedule": {
    "quartz_cron_expression": "19 0 6 * * ?",
    "timezone_id": "UTC",
    "pause_status": "PAUSED"
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "ingest_weather",
      "description": "Ingests retrospective Open-Meteo archive observations through the available date.",
      "notebook_task": {
        "notebook_path": "src/bronze/ingest_weather",
        "source": "GIT"
      },
      "timeout_seconds": 1800
    },
    {
      "task_key": "ingest_zonal",
      "description": "Ingests observed ERCOT weather-zone demand for dashboard analytics.",
      "notebook_task": {
        "notebook_path": "src/bronze/ingest_ercot_zonal",
        "source": "GIT"
      },
      "timeout_seconds": 7200
    },
    {
      "task_key": "clean_weather",
      "depends_on": [
        {
          "task_key": "ingest_weather"
        }
      ],
      "notebook_task": {
        "notebook_path": "src/silver/clean_weather",
        "source": "GIT"
      },
      "timeout_seconds": 1800
    },
    {
      "task_key": "clean_zonal",
      "description": "Cleans newly ingested zonal demand and joins the latest available ERCOT system-demand reference.",
      "depends_on": [
        {
          "task_key": "ingest_zonal"
        }
      ],
      "notebook_task": {
        "notebook_path": "src/silver/clean_ercot_zonal",
        "source": "GIT"
      },
      "timeout_seconds": 1800
    },
    {
      "task_key": "build_zonal_summary",
      "description": "Publishes observed zonal-demand analytics for the dashboard.",
      "depends_on": [
        {
          "task_key": "clean_zonal"
        }
      ],
      "notebook_task": {
        "notebook_path": "src/gold/zonal_demand_summary",
        "source": "GIT"
      },
      "timeout_seconds": 1800
    },
    {
      "task_key": "evaluate_benchmarks",
      "description": "Daily issue-time-matched H24 versus EIA evaluation; pending status remains until mature matched targets exist.",
      "notebook_task": {
        "notebook_path": "src/gold/benchmark_evaluation_task",
        "source": "GIT"
      },
      "timeout_seconds": 900,
      "max_retries": 1
    }
  ],
  "format": "MULTI_TASK"
}
