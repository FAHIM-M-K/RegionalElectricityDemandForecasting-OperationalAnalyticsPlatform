{
  "name": "ERCOT_Monthly_Model_Retraining",
  "schedule": {
    "quartz_cron_expression": "0 0 6 1 * ?",
    "timezone_id": "UTC",
    "pause_status": "UNPAUSED"
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "retrain_model",
      "description": "Retrains candidate EIA-Hybrid LightGBM model over dynamic 36-month rolling window.",
      "notebook_task": {
        "notebook_path": "src/mlops/retrain_model",
        "source": "GIT"
      },
      "timeout_seconds": 3600
    },
    {
      "task_key": "validate_model",
      "description": "Evaluates candidate holdout MAE and peak reliability against active Production model. Promotes if >=0.5% lift.",
      "depends_on": [
        {
          "task_key": "retrain_model"
        }
      ],
      "notebook_task": {
        "notebook_path": "src/mlops/validate_model",
        "source": "GIT"
      },
      "timeout_seconds": 1800
    }
  ],
  "format": "MULTI_TASK"
}