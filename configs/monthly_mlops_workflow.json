{
  "name": "ERCOT_Monthly_Model_Retraining",
  "schedule": {
    "quartz_cron_expression": "0 0 6 1 * ?",
    "timezone_id": "UTC",
    "pause_status": "UNPAUSED"
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "build_forecast_examples",
      "description": "Builds the canonical H24/H168 point-in-time examples from the demand fact table.",
      "notebook_task": {
        "notebook_path": "src/gold/build_forecast_examples",
        "source": "GIT"
      },
      "timeout_seconds": 1800
    },
    {
      "task_key": "retrain_model",
      "description": "Retrains independent direct LightGBM models for H24 (Day-Ahead) and H168 (Week-Ahead) over dynamic rolling window.",
      "depends_on": [
        {
          "task_key": "build_forecast_examples"
        }
      ],
      "notebook_task": {
        "notebook_path": "src/mlops/retrain_model",
        "source": "GIT"
      },
      "timeout_seconds": 3600
    },
    {
      "task_key": "validate_model",
      "description": "Promotes only candidates that beat their matching rolling-selection naive baseline; final holdout is reporting-only.",
      "depends_on": [
        {
          "task_key": "retrain_model"
        }
      ],
      "notebook_task": {
        "notebook_path": "src/mlops/validate_model",
        "source": "GIT"
      },
      "timeout_seconds": 1800
    }
  ],
  "format": "MULTI_TASK"
}
