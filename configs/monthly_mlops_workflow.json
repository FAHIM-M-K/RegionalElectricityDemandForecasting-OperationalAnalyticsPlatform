{
  "name": "ERCOT_Monthly_Model_Retraining",
  "schedule": {
    "quartz_cron_expression": "0 0 6 1 * ?",
    "timezone_id": "UTC",
    "pause_status": "PAUSED"
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "build_forecast_examples",
      "description": "Builds hourly-origin point-in-time examples for the active rolling H24 forecast.",
      "notebook_task": {
        "notebook_path": "src/gold/build_hourly_forecast_examples",
        "source": "GIT"
      },
      "timeout_seconds": 1800
    },
    {
      "task_key": "backfill_weather_vintages",
      "description": "Resolves only missing issue-time H24 ECMWF weather origins before training-example materialization; API attempts are hard-capped and checkpointed.",
      "depends_on": [
        {
          "task_key": "build_forecast_examples"
        }
      ],
      "notebook_task": {
        "notebook_path": "src/mlops/backfill_weather_vintages",
        "source": "GIT"
      },
      "timeout_seconds": 3600,
      "max_retries": 0
    },
    {
      "task_key": "build_weather_training_examples",
      "description": "Joins complete archived ECMWF forecasts to rolling demand examples using only weather available by the simulated hourly issue cutoff.",
      "depends_on": [
        {
          "task_key": "backfill_weather_vintages"
        }
      ],
      "notebook_task": {
        "notebook_path": "src/gold/build_weather_training_examples",
        "source": "GIT"
      },
      "timeout_seconds": 1800
    },
    {
      "task_key": "retrain_model",
      "description": "Retrains independent direct LightGBM models with demand history and issue-time ECMWF weather on matched rolling origins.",
      "depends_on": [
        {
          "task_key": "build_weather_training_examples"
        }
      ],
      "notebook_task": {
        "notebook_path": "src/mlops/retrain_model",
        "source": "GIT"
      },
      "timeout_seconds": 3600
    },
    {
      "task_key": "validate_model",
      "description": "Promotes the H24 candidate only when it repeatedly beats the daily-naive baseline; final holdout is reporting-only.",
      "depends_on": [
        {
          "task_key": "retrain_model"
        }
      ],
      "notebook_task": {
        "notebook_path": "src/mlops/validate_model",
        "source": "GIT"
      },
      "timeout_seconds": 1800
    }
  ],
  "format": "MULTI_TASK"
}
