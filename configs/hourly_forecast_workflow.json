{
  "name": "ERCOT_3H_Forecast_and_Monitoring",
  "schedule": {
    "quartz_cron_expression": "0 15 */3 * * ?",
    "timezone_id": "UTC",
    "pause_status": "PAUSED"
  },
  "max_concurrent_runs": 1,
  "tasks": [
    {
      "task_key": "ingest_weather_forecast",
      "description": "Captures one batched ECMWF IFS hourly forecast vintage for all four ERCOT sites; 429 quota errors are not retried.",
      "notebook_task": {
        "notebook_path": "src/bronze/ingest_weather_forecast",
        "source": "GIT"
      },
      "timeout_seconds": 300,
      "max_retries": 0
    },
    {
      "task_key": "clean_weather_forecast",
      "description": "Conforms issue-time forecast snapshots into availability-stamped regional weather features.",
      "depends_on": [
        {
          "task_key": "ingest_weather_forecast"
        }
      ],
      "notebook_task": {
        "notebook_path": "src/silver/clean_weather_forecast",
        "source": "GIT"
      },
      "timeout_seconds": 600,
      "max_retries": 1
    },
    {
      "task_key": "ingest_eia",
      "description": "Incremental EIA actual demand ingestion with a restatement buffer.",
      "notebook_task": {
        "notebook_path": "src/bronze/ingest_eia",
        "source": "GIT"
      },
      "timeout_seconds": 600,
      "max_retries": 2,
      "min_retry_interval_millis": 120000,
      "retry_on_timeout": true
    },
    {
      "task_key": "clean_eia",
      "description": "Cleans and standardizes incremental EIA observed system demand.",
      "depends_on": [
        {
          "task_key": "ingest_eia"
        }
      ],
      "notebook_task": {
        "notebook_path": "src/silver/clean_eia_demand",
        "source": "GIT"
      },
      "timeout_seconds": 600,
      "max_retries": 2,
      "min_retry_interval_millis": 120000,
      "retry_on_timeout": true
    },
    {
      "task_key": "preflight_health_check",
      "description": "Read-only preflight verifying catalog access and production model availability before scoring.",
      "notebook_task": {
        "notebook_path": "src/gold/preflight_serving_check",
        "source": "GIT"
      },
      "timeout_seconds": 300,
      "max_retries": 1,
      "depends_on": [
        {
          "task_key": "clean_eia"
        }
      ]
    },
    {
      "task_key": "conform_grid_weather",
      "description": "Refreshes canonical hourly demand conformation after EIA ingestion; weather is optional enrichment.",
      "depends_on": [
        {
          "task_key": "clean_eia"
        }
      ],
      "notebook_task": {
        "notebook_path": "src/silver/conformed_grid_weather",
        "source": "GIT"
      },
      "timeout_seconds": 900,
      "max_retries": 1
    },
    {
      "task_key": "build_demand_fact",
      "description": "Enriches conformed grid records with operational indicators and updates fact_hourly_electricity_demand.",
      "depends_on": [
        {
          "task_key": "conform_grid_weather"
        }
      ],
      "notebook_task": {
        "notebook_path": "src/gold/fact_hourly_demand",
        "source": "GIT"
      },
      "timeout_seconds": 600,
      "max_retries": 1
    },
    {
      "task_key": "score_forecast_hourly",
      "description": "Issues one rolling H24 forecast curve from the latest valid demand origin; atomically publishes the 24 active leads and appends issue history.",
      "run_if": "ALL_SUCCESS",
      "depends_on": [
        {
          "task_key": "build_demand_fact"
        },
        {
          "task_key": "clean_weather_forecast"
        },
        {
          "task_key": "preflight_health_check"
        }
      ],
      "notebook_task": {
        "notebook_path": "src/gold/score_forecast_hourly",
        "source": "GIT"
      },
      "timeout_seconds": 600,
      "max_retries": 1
    },
    {
      "task_key": "monitor_forecasts",
      "description": "Joins matured actuals to issued forecast history and materializes rolling monitoring metrics.",
      "depends_on": [
        {
          "task_key": "score_forecast_hourly"
        }
      ],
      "notebook_task": {
        "notebook_path": "src/mlops/monitor_forecasts",
        "source": "GIT"
      },
      "timeout_seconds": 600,
      "max_retries": 1
    }
  ],
  "format": "MULTI_TASK"
}
